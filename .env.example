# Copy this file to .env and uncomment the keys you need.
# .env is gitignored; never commit it or paste real keys into issues/chats.

# OpenAI / OpenAI-compatible endpoints
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1

# OpenRouter
# OPENROUTER_API_KEY=
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Anthropic
# ANTHROPIC_API_KEY=

# Google Gemini
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# GitHub Models
# GITHUB_TOKEN=

# Local OpenAI-compatible servers (Ollama, llama.cpp, etc.)
# LOCAL_API_KEY=local
# LOCAL_API_BASE=http://localhost:11434/v1
